# Copie este arquivo para .env e preencha os valores.

PORT=3000
PUBLIC_APP_URL=http://localhost:3000

# Segredo longo e aleatório (sessões JWT internas)
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Mesmo secret que você configurar no webhook da Cakto
CAKTO_WEBHOOK_SECRET=troque-pelo-secret-do-webhook-cakto

# Token para acessar /admin.html e APIs de administração
ADMIN_TOKEN=troque-por-um-token-admin-forte

# E-mail automático da chave (opcional, mas recomendado)
# No Render Free o SMTP (portas 587/465) é bloqueado. Use o webhook HTTPS do
# Google Apps Script (scripts/gmail-relay.gs) em produção.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# SMTP local (Gmail). No Render Free fica ignorado, a menos que EMAIL_ALLOW_SMTP=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Contabiliza <noreply@seudominio.com>"
# EMAIL_ALLOW_SMTP=true
